{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.7.1"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "public"
            }
        }
    ],
    "routes": [
        {
            "src": "/(build|css|js|images|fonts|storage)/(.*)$",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            },
            "dest": "public/$1/$2"
        },
        {
            "src": "/favicon.ico$",
            "dest": "public/favicon.ico"
        },
        {
            "src": "/robots.txt$",
            "dest": "public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "CACHE_DRIVER": "array",
        "QUEUE_CONNECTION": "sync",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "APP_STORAGE": "/tmp",
        "FILESYSTEM_DRIVER": "cloudinary",
        "SESSION_LIFETIME": "120",
        "BCRYPT_ROUNDS": "10",
        "MIX_PUSHER_APP_KEY": "",
        "MIX_PUSHER_APP_CLUSTER": "mt1"
    }
}
